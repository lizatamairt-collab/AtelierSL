# Port d'écoute du serveur de pré-rendu
PORT=8080

# URL de base de l'API JSON existante (auth-api), SANS slash final
API_URL=https://api.example.com/api

# Domaine public du site (utilisé pour canonical, og:url, JSON-LD)
SITE_URL=https://example.com

# Chemin vers client/index.html — laissez commenté : la valeur par défaut
# (client/index.html au même niveau que ssr-server/) convient si vous gardez
# l'arborescence fournie (voir README.md à la racine du projet).
# CLIENT_HTML_PATH=/chemin/vers/client/index.html

# Durée du cache mémoire des réponses API, en ms (défaut 60000 = 1 min)
SSR_CACHE_TTL_MS=60000

# Dossiers du front et de l'admin — laissez commentés : par défaut
# client/ et admin/ à la racine du projet.
# CLIENT_DIR=/chemin/vers/client
# ADMIN_DIR=/chemin/vers/admin
