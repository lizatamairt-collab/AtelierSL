# ── SERVEUR ─────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MYSQL (HOSTINGER hPanel) ─────────────────────────
# Identifiants trouvables sur hPanel → Bases de données → MySQL.
# DB_HOST est généralement "localhost" quand l'app Node tourne sur le
# même hébergement Hostinger que la base de données.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_votreuser
DB_PASSWORD=votre-mot-de-passe
DB_NAME=u123456789_votrebase
# Hostinger n'exige pas SSL pour une connexion locale (DB_HOST=localhost).
# Passez à true uniquement si votre configuration l'impose (accès distant).
DB_SSL=false

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-moi-avec-une-chaine-longue-et-aleatoire
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-moi-avec-une-autre-chaine-longue-et-aleatoire
JWT_REFRESH_EXPIRES_IN=30d

# ── BCRYPT ───────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── EMAIL (nodemailer) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
EMAIL_FROM="Atelier S.L <contact@votredomaine.dz>"

# ── Cloudinary ───────────────────────────────
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret

# ── APP ──────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5500,http://localhost:3000

# ── COMMANDES ────────────────────────────────────────────────────────────────
# en DZD — frais appliqués sous le seuil gratuit
FRAIS_LIVRAISON_DEFAUT=500
# en DZD — livraison offerte au-delà de ce montant
SEUIL_LIVRAISON_GRATUITE=10000

# ── CONTACT ──────────────────────────────────────────────────────────────────
# Nom de la boutique affiché sur les factures PDF
SHOP_NAME="Atelier S.L"

# Email qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=contact@votredomaine.dz

# ── ADMIN ────────────────────────────────────────────────────────────────────
# Seul(s) le(s) email(s) listé(s) ici peuvent exercer les droits admin.
ADMIN_EMAIL=admin@votredomaine.dz
ADMIN_EMAILS=admin@votredomaine.dz

# Session (OAuth uniquement — pas de session permanente)
SESSION_SECRET=change-moi-avec-une-chaine-longue-et-aleatoire

# ── GOOGLE OAuth 2.0 ──────────────────────────────────────────────────────────
# Obtenez ces clés sur : https://console.cloud.google.com/
#   1. Créer un projet  →  "APIs & Services"  →  "Credentials"
#   2. "Create Credentials"  →  "OAuth 2.0 Client ID"
#   3. Type : "Web application"
#   4. Authorized redirect URIs :
#        http://localhost:3000/api/auth/google/callback     ← dev
#        https://votre-domaine.dz/api/auth/google/callback  ← prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── FACEBOOK Login ────────────────────────────────────────────────────────────
# Obtenez ces clés sur : https://developers.facebook.com/
#   1. "Create App"  →  type "Consumer"
#   2. Ajouter le produit "Facebook Login"
#   3. Paramètres  →  "Valid OAuth Redirect URIs" :
#        http://localhost:3000/api/auth/facebook/callback   ← dev
#        https://votre-domaine.dz/api/auth/facebook/callback ← prod
#   4. App ID + App Secret dans "Paramètres de base"
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── CHARGILY PAY (paiement en ligne CIB / EDAHABIA) ───────────────────────────
# Clés à récupérer sur : https://pay.chargily.com/ (espace marchand → API Keys)
#   - Utilisez les clés "Test" tant que le compte marchand n'est pas validé,
#     puis passez CHARGILY_MODE=live avec les clés "Live".
CHARGILY_MODE=test
CHARGILY_API_KEY=

# URL publique (HTTPS, joignable depuis Internet) de votre webhook. En local,
# Chargily ne peut pas atteindre localhost : utilisez un tunnel (ngrok, etc.)
# pour tester, ou reposez-vous sur GET /paiement-chargily/verifier en dev.
CHARGILY_WEBHOOK_URL=https://votredomaine.dz/api/paiements/chargily/webhook

# Les visites s'affichent dans la rubrique "Visiteurs" du panneau admin.
# Notification (cloche) à chaque nouveau visiteur : désactivée par défaut,
# mettre "true" pour l'activer (1 par visiteur et par jour, robots ignorés).
NOTIF_VISITEURS=false
# Plafond de notifications "visiteur" par heure, si activées (anti-spam)
NOTIF_VISITEURS_MAX_HEURE=60
# (Optionnel) Secret qui protège le hash anonyme des visiteurs. Par défaut, JWT_SECRET est utilisé.
# VISITES_SECRET=

# ── WHATSAPP CLOUD API (notification admin « Nouvelle commande ») ─────────────
# Optionnel : désactivé par défaut (aucun envoi tant que WHATSAPP_ENABLED != true).
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
# Numéros admin destinataires, format E.164 sans "+", séparés par des virgules
# (ex : 213XXXXXXXXX,213YYYYYYYYY)
WHATSAPP_ADMIN_NUMBERS=
WHATSAPP_API_VERSION=v20.0
# Nom du template approuvé dans Meta Business Manager (optionnel)
# WHATSAPP_TEMPLATE_NOUVELLE_COMMANDE=
